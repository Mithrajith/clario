# Clario Environment Variables Template
# Copy this file to .env and configure with your credentials

# Application Configuration
ENVIRONMENT=production
PROJECT_NAME="Clario"
SERVICE_NAME="clario-backend"
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80

# Relational Database Configuration (PostgreSQL / Neon PostgreSQL)
# Example Local: postgresql://clario_user:clario_password@localhost:5432/clario_db
# Example Neon: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://clario_user:clario_password@localhost:5432/clario_db
POSTGRES_USER=clario_user
POSTGRES_PASSWORD=clario_password
POSTGRES_DB=clario_db
POSTGRES_PORT=5432

# Vector Database Configuration (Qdrant Local or Qdrant Cloud)
# Example Local: http://localhost:6333
# Example Cloud: https://xyz.us-west-2-0.aws.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=clario_documents
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Generation Provider Configuration
# Supported providers: groq, openai, mock
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here

# Embedding & Reranker Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Processing
DOCUMENT_STORAGE_PATH=/tmp/clario_storage
MAX_UPLOAD_SIZE_MB=50
